{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "IISMonitoring.Web.Services.MonitoringBackgroundService": "Information",
      "IISMonitoring.Web.Services.OptimizedIISMonitoringService": "Information",
      "IISMonitoring.Web.Services.IISApmBackgroundService": "Debug",
      "IISMonitoring.Web.Services.IISLogParserService": "Debug"
    }
  },
  "AllowedHosts": "*",
  "Monitoring": {
    "UpdateIntervalMs": 5000,
    "EnableCounterCaching": true,
    "CounterCacheLifetimeMinutes": 30,
    "MaxCounterRetries": 3,
    "EnableHistoricalData": true,
    "HistoricalDataRetentionMinutes": 10,
    "HistoricalDataPath": "Data/historical-data.json"
  },
  "Apm": {
    "UpdateIntervalMs": 5000,
    "MonitoredSites": []
  },
  "ServiceName": "IISMonitoring"
}
